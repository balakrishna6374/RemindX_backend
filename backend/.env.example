# ==========================================
# RemindX — Environment Configuration Template
# Copy this file to .env and configure your secrets
# ==========================================

PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/remindx

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Nodemailer / SMTP Email Notification Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_here
EMAIL_FROM="RemindX Alerts" <no-reply@remindx.com>

# Initial Administrator Account Seed
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173

# Cron Schedule (Default: Every day at 8:00 AM)
CRON_SCHEDULE="0 8 * * *"

